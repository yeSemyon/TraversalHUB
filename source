local function getOtherPlayer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            return p
        end
    end
    return nil
end

local function firePlayerDelete(target)
    local args = {
        [1] = {
            [1] = {
                [1] = "\24",
                [2] = target,
                [3] = math.huge
            }
        }
    }
    RS:WaitForChild("RemoteEvent"):FireServer(unpack(args))
end

local function withOther(fn)
    local other = getOtherPlayer()
    if not other or not other.Character then return end
    fn(other.Character)
end

