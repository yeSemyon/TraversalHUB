    local char = LP.Character
    local path = char:FindFirstChild("ClientCode")
    local list = {"Bat", "Knife", "Axe", "Machete", "Crowbar", "Chainsaw", "Katana"}
    for _, tool in pairs(char:GetChildren()) do
