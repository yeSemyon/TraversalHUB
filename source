local currentTheme = "Bright"
local themeRefs = {}

local function register(instance, property, key)
    themeRefs[instance] = themeRefs[instance] or {}
    themeRefs[instance][property] = key
end

local bylineShine
local buttonState = {}
local stickyButtons = {}

local function applyTheme(name)
    currentTheme = name
    local T = Themes[name]
    for inst, props in pairs(themeRefs) do
        if inst.Parent then
            local skip = false
            if inst:IsA("TextButton") and stickyButtons[inst] then
                skip = true
            end
            if not skip then
                for prop, key in pairs(props) do
                    inst[prop] = T[key]
                end
            end
        end
    end

    for btn, data in pairs(stickyButtons) do
        if btn.Parent and data.active then
            btn.BackgroundColor3 = data.green
            if data.stroke then data.stroke.Color = data.greenStroke end
            if data.label then data.label.TextColor3 = data.greenText end
        end
    end

    for btn, data in pairs(buttonState) do
        if btn.Parent then
            if stickyButtons[btn] and stickyButtons[btn].active then
            elseif data.hovered then
                btn.BackgroundColor3 = T.buttonHov
                if data.stroke then data.stroke.Color = T.strokeHov end
                if data.label then data.label.TextColor3 = T.textMain end
            else
                btn.BackgroundColor3 = T.button
                if data.stroke then data.stroke.Color = T.stroke end
                if data.label then data.label.TextColor3 = T.textNorm end
            end
        end
    end

    if bylineShine then
        if name == "Dark" then
            bylineShine.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, T.byline2),
                ColorSequenceKeypoint.new(0.30, T.byline1),
                ColorSequenceKeypoint.new(0.50, T.byline3),
                ColorSequenceKeypoint.new(0.70, T.byline1),
                ColorSequenceKeypoint.new(1.00, T.byline2),
            })
        else
            bylineShine.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, T.byline1),
                ColorSequenceKeypoint.new(0.30, T.byline2),
                ColorSequenceKeypoint.new(0.50, T.byline3),
                ColorSequenceKeypoint.new(0.70, T.byline2),
                ColorSequenceKeypoint.new(1.00, T.byline1),
            })
        end
    end
end

