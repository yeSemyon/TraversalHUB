    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -16, 1, -16)
    page.Position = UDim2.fromOffset(8, 8)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 82)
    page.Visible = false
    page.Parent = content

    local pageList = Instance.new("UIListLayout")
    pageList.Padding = UDim.new(0, 6)
    pageList.SortOrder = Enum.SortOrder.LayoutOrder
    pageList.Parent = page

    local entry = { button = btn, label = label, accent = accent, accentGlow = accentGlow, page = page }
    tabs[#tabs + 1] = entry

    btn.MouseEnter:Connect(function()
        if page.Visible then return end
        local T = Themes[currentTheme]
        btn.BackgroundColor3 = T.buttonHov
        label.TextColor3 = T.textNorm
    end)
    btn.MouseLeave:Connect(function()
        if page.Visible then return end
        local T = Themes[currentTheme]
        btn.BackgroundColor3 = T.panel
        label.TextColor3 = T.textDim
    end)

    btn.MouseButton1Click:Connect(function()
        local T = Themes[currentTheme]
        for _, t in ipairs(tabs) do
            t.page.Visible = false
            t.button.BackgroundColor3 = T.panel
            t.label.TextColor3 = T.textDim
            t.accent.BackgroundColor3 = T.accentDim
            TweenService:Create(t.accentGlow, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
        end
        page.Visible = true
        btn.BackgroundColor3 = T.button
        label.TextColor3 = T.textMain
        accent.BackgroundColor3 = T.accent

        accentGlow.BackgroundColor3 = T.accentGlow
        accentGlow.BackgroundTransparency = 0.4
        TweenService:Create(accentGlow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0.85
        }):Play()
        TweenService:Create(accent, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 3, 0, 18)
        }):Play()
        task.delay(0.35, function()
            TweenService:Create(accent, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 2, 0, 14)
            }):Play()
        end)
    end)

    return entry
end

local FLASH_GREEN        = Color3.fromRGB(60, 190, 90)
local FLASH_GREEN_STROKE = Color3.fromRGB(90, 230, 120)
local FLASH_GREEN_TEXT   = Color3.fromRGB(255, 255, 255)

local function button(page, text, callback, opts)
    opts = opts or {}
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = page
    register(btn, "BackgroundColor3", "button")
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Parent = btn
    register(stroke, "Color", "stroke")

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.fromOffset(10, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = btn
    register(label, "TextColor3", "textNorm")

    local sticky = opts.sticky == true
    local stateData = { hovered = false, stroke = stroke, label = label }
    buttonState[btn] = stateData

    local stickyData = {
        active = false,
        green = FLASH_GREEN,
        greenStroke = FLASH_GREEN_STROKE,
        greenText = FLASH_GREEN_TEXT,
        stroke = stroke,
        label = label,
    }
    stickyButtons[btn] = stickyData

    local function paintIdle()
        if sticky and stickyData.active then
            btn.BackgroundColor3 = FLASH_GREEN
            stroke.Color = FLASH_GREEN_STROKE
            label.TextColor3 = FLASH_GREEN_TEXT
            return
        end
        local T = Themes[currentTheme]
        if stateData.hovered then
            btn.BackgroundColor3 = T.buttonHov
            stroke.Color = T.strokeHov
            label.TextColor3 = T.textMain
        else
            btn.BackgroundColor3 = T.button
            stroke.Color = T.stroke
            label.TextColor3 = T.textNorm
        end
    end

    btn.MouseEnter:Connect(function()
        stateData.hovered = true
        if sticky and stickyData.active then return end
        local T = Themes[currentTheme]
        btn.BackgroundColor3 = T.buttonHov
        stroke.Color = T.strokeHov
        label.TextColor3 = T.textMain
    end)
    btn.MouseLeave:Connect(function()
        stateData.hovered = false
        paintIdle()
    end)

    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = FLASH_GREEN
        stroke.Color = FLASH_GREEN_STROKE
        label.TextColor3 = FLASH_GREEN_TEXT

        if sticky then
            stickyData.active = true
        else
            task.delay(0.35, function()
                if btn.Parent then paintIdle() end
            end)
        end

        local ok, err = pcall(callback)
        if not ok then warn("[Traversal] callback error: " .. tostring(err)) end
    end)

    stateData.paint = paintIdle

    return btn
end

