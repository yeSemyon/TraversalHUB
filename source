            local up = debug.getupvalues(v)
            if up[76] == 100 or (type(up[76]) == "number" and up[76] > 0) then
                fn = v
                break
            end
        end
    end
    RunService.Heartbeat:Connect(function()
        if fn then debug.setupvalue(fn, 76, 100) end
    end)
end)

